{
  "name": "hyperswarm",
  "version": "4.17.0",
  "description": "A distributed networking stack for connecting peers",
  "files": [
    "index.js",
    "lib/**.js"
  ],
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  },
  "dependencies": {
    "b4a": "^1.3.1",
    "bare-events": "^2.2.0",
    "hyperdht": "https://codeload.github.com/ayooooo123/hyperdht/tar.gz/28f7e51b40cf2000d6a43beec62bfc785cfb3cca",
    "safety-catch": "^1.0.2",
    "shuffled-priority-queue": "^2.1.0",
    "streamx": "^2.22.1",
    "unslab": "^1.3.0"
  },
  "overrides": {
    "dht-rpc": "https://codeload.github.com/ayooooo123/dht-rpc/tar.gz/fe04496196ea2ce42d1de27b0f770b02d2a87cd5",
    "sodium-native": "https://codeload.github.com/ayooooo123/sodium-native/tar.gz/562d642e1a78a8e124cf97bfbda77f01c02d1a7f"
  },
  "devDependencies": {
    "bare-process": "^4.2.2",
    "brittle": "^3.0.2",
    "hypercore-crypto": "^3.4.0",
    "lunte": "^1.3.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "which-runtime": "^1.3.2"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:node && npm run test:bare",
    "test:generate": "brittle -r test/all.js test/*.js",
    "test:node": "brittle-node --coverage test/*.js",
    "test:bare": "bare test/all.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayooooo123/hyperswarm.git"
  },
  "author": "Mathias Buus (@mafintosh)",
  "contributors": [
    "David Mark Clements (@davidmarkclem)",
    "Andrew Osheroff (@andrewosh)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/holepunchto/hyperswarm/issues"
  },
  "homepage": "https://github.com/holepunchto/hyperswarm"
}
